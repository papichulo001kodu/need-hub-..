# ==============================================================================
# NeedHub Environment Configuration Template
# Copy this file to `.env` in your production or local environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & DEPLOYMENT CONFIGURATION
# ------------------------------------------------------------------------------
# Server Port (Default is 3000 for standard container & VPS deployments)
PORT=3000
NODE_ENV=production

# Public canonical URL where the app is hosted (e.g., https://needhub.com)
APP_URL=
VITE_APP_URL=

# JSON Web Token Secret for Admin Authentication & API signing
# Generate a strong 64-character random string for production
JWT_SECRET=needhub-secure-production-jwt-secret-key-2026

# Optional: Gemini API Key for AI features (Server-side only)
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. ADMIN AUTHENTICATION INITIAL CREDENTIALS
# ------------------------------------------------------------------------------
# Initial superadmin credentials for the Admin Dashboard
ADMIN_EMAIL=admin@needhub.com
ADMIN_PASSWORD=Admin@NeedHub2026!

# ------------------------------------------------------------------------------
# 3. CLIENT / APP BRANDING & PWA CONFIGURATION (Public VITE_ Variables)
# ------------------------------------------------------------------------------
VITE_APP_NAME=NeedHub
VITE_APP_TAGLINE=Fresh Groceries & Home Services Delivered
VITE_APK_DOWNLOAD_URL=/NeedHub_v1.0.apk

# ------------------------------------------------------------------------------
# 4. FIREBASE CLIENT CONFIGURATION (Optional - Public Web Credentials)
# Provide these if you connect Firebase Authentication, Firestore, or Cloud Storage
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# 5. FIREBASE ADMIN SERVICE ACCOUNT (Optional - Private Server Secrets)
# Never expose these in client-side code or commit to source control.
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or path to service account json:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

